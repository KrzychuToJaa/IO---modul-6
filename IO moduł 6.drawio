169, 170, 0.52) rgb(18, 19, 20); font-size: 14px;&quot;&gt;&lt;b style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20); font-size: 14px;&quot;&gt;Moduł 4 - Zapisy i listy rezerwowe&lt;/b&gt;&lt;br style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20); font-size: 14px;&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0); font-size: 14px;&quot;&gt;Lista główna i status zapisu. Obecność można potwierdzić tylko dla osoby z listy głównej.&lt;/span&gt;" vertex="1">
